pkgname=onesec
pkgver=0.1.0
pkgrel=1
pkgdesc='A breathing pause in front of the apps you pick'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'hyprland' 'libnotify')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/onesec "$pkgdir/usr/bin/onesec"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/onesec.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/onesec.svg"
  install -Dm644 "$startdir/onesec.desktop" "$pkgdir/usr/share/applications/onesec.desktop"
  # The Hyprland hook. Each user loads it from their hyprland.lua.
  install -Dm644 hypr/onesec.lua "$pkgdir/usr/share/onesec/onesec.lua"
}
