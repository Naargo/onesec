pkgname=onesec
pkgver=0.4.0
pkgrel=1
pkgdesc='A breathing pause in front of the apps you pick'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'hyprland' 'libnotify' 'python')
optdepends=('brave-bin: the OneSec extension for websites' 'chromium: the OneSec extension for websites')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/onesec "$pkgdir/usr/bin/onesec"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/onesec.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/onesec.svg"
  install -Dm644 "$startdir/onesec.desktop" "$pkgdir/usr/share/applications/onesec.desktop"
  # The Hyprland hook. Each user loads it from their hyprland.lua.
  install -Dm644 hypr/onesec.lua "$pkgdir/usr/share/onesec/onesec.lua"
  # The bar widget. Each user links it into ~/.config/omarchy/plugins.
  install -Dm644 -t "$pkgdir/usr/share/onesec/plugin" plugin/manifest.json plugin/OneSecBar.qml
  install -Dm644 -t "$pkgdir/usr/share/onesec/plugin/i18n" plugin/i18n/en.json
  # The browser extension, the helper it talks to, and the command that
  # turns both on for a user.
  install -Dm644 -t "$pkgdir/usr/share/onesec/extension" extension/*
  install -Dm755 browser/onesec-host "$pkgdir/usr/lib/onesec/onesec-host"
  install -Dm755 browser/onesec-browser-setup "$pkgdir/usr/bin/onesec-browser-setup"
}
