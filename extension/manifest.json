{
  "manifest_version": 3,
  "name": "OneSec",
  "version": "0.4.0",
  "description": "While OneSec is on, the websites you pick in OneSec open after a breathing pause.",
  "key": "",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
